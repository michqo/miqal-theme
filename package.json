{
  "name": "@miqal/theme",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Tailwind v4 design tokens + base styles for Miqal apps",
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "test": "node --test tests/*.test.mjs && npm run generate:check",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "prepack": "npm test"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "culori": "^4.0.2",
    "postcss": "^8.5.6"
  },
  "license": "MIT",
  "keywords": [
    "miqal",
    "design-system",
    "tailwindcss",
    "css-variables",
    "theme",
    "oklch"
  ],
  "exports": {
    "./core.css": "./core.css",
    "./canvas.css": "./canvas.css",
    "./motion.css": "./motion.css",
    "./theme.css": "./theme.css",
    "./tokens.json": "./tokens.json",
    "./tokens.srgb.json": "./tokens.srgb.json",
    "./components.css": "./components.css",
    "./system.css": "./system.css"
  },
  "files": [
    "core.css",
    "canvas.css",
    "motion.css",
    "theme.css",
    "tokens.json",
    "tokens.srgb.json",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "components.css",
    "system.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miqal/theme"
  }
}
